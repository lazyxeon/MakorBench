{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://makorbench.dev/schemas/oracle.schema.json",
  "title": "MakorBench Private Oracle Record",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","task_id","causal_mechanism","causal_roles","causal_chain","accepted_reproduction","accepted_interventions","plausible_alternatives","counterfactual_variants","provenance"],
  "properties":{
    "schema_version":{"type":"string","const":"0.1"},
    "task_id":{"type":"string","minLength":1},
    "causal_mechanism":{"type":"string","minLength":1},
    "causal_roles":{"type":"array","minItems":1,"items":{"type":"object"}},
    "causal_chain":{"type":"array","minItems":1,"items":{"type":"string"}},
    "accepted_reproduction":{"type":"array","minItems":1,"items":{"type":"string"}},
    "accepted_interventions":{"type":"array","minItems":1,"items":{"type":"string"}},
    "plausible_alternatives":{"type":"array","minItems":2,"items":{"type":"string"}},
    "counterfactual_variants":{"type":"array","minItems":1,"items":{"type":"string"}},
    "provenance":{"type":"object"},
    "human_validation":{"type":"object"},
    "known_shortcuts":{"type":"array","items":{"type":"string"}}
  }
}