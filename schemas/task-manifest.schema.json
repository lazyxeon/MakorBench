{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://makorbench.dev/schemas/task-manifest.schema.json",
  "title": "MakorBench Public Task Manifest",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","task_id","benchmark_version","prompt_path","environment","budget","network_policy"],
  "properties":{
    "schema_version":{"type":"string","const":"0.1"},
    "task_id":{"type":"string","pattern":"^[A-Za-z0-9._-]+$"},
    "benchmark_version":{"type":"string","minLength":1},
    "prompt_path":{"type":"string","minLength":1},
    "environment":{
      "type":"object","additionalProperties":false,
      "required":["image_digest","repository_commit"],
      "properties":{
        "image_digest":{"type":"string","minLength":1},
        "repository_commit":{"type":"string","minLength":7},
        "architecture":{"type":["string","null"]},
        "seed":{"type":["integer","null"]}
      }
    },
    "budget":{
      "type":"object","additionalProperties":false,
      "required":["wall_time_seconds"],
      "properties":{
        "wall_time_seconds":{"type":"integer","minimum":1},
        "max_turns":{"type":["integer","null"],"minimum":1},
        "max_tool_calls":{"type":["integer","null"],"minimum":1}
      }
    },
    "network_policy":{"type":"string","enum":["isolated","curated-local","open-world"]},
    "track":{"type":"string","enum":["canonical","open-world","diagnosis-only","intervention-only"],"default":"canonical"}
  }
}